# Python 3.10+; install gigachat or gigachat[aiohttp] for the optional async backend.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Required unless the model is passed per request; the SDK has no default model.
GIGACHAT_MODEL=GigaChat-2
# GIGACHAT_SESSION_ID=conversation-123
# GIGACHAT_BASE_URL=https://api.giga.chat/v1
# Verification uses system trust unless a CA bundle or SSLContext is supplied.
# GIGACHAT_CA_BUNDLE_FILE=/path/to/ca-bundle.pem
GIGACHAT_VERIFY_SSL_CERTS=true
GIGACHAT_TRUST_ENV=true
# GIGACHAT_PROXY=http://localhost:8080
GIGACHAT_TIMEOUT=30
GIGACHAT_MAX_RETRIES=0
GIGACHAT_MAX_RETRY_TIME=60
GIGACHAT_MAX_SSE_EVENT_SIZE=1048576
# Unset max_connections inherits the effective bounded transport default.
# GIGACHAT_MAX_CONNECTIONS=100
# Native HTTPX2 is the default. aiohttp requires the optional extra and asyncio.
GIGACHAT_ASYNC_BACKEND=httpx2
# GIGACHAT_ASYNC_BACKEND=aiohttp
# SSLContext, HTTPX2 Timeout/Limits, and injected clients are Python objects,
# not environment variable values. See MIGRATION.md for examples and precedence.
